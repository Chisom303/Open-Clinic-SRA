{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-clinic-sra/open-clinic-sra/content/schema.json",
  "title": "Open Clinic SRA question file",
  "type": "object",
  "required": ["section", "questions"],
  "additionalProperties": false,
  "properties": {
    "section": { "type": "string", "pattern": "^[a-z_]+$" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "text", "help", "citation", "implementation",
        "likelihood", "impact", "critical", "allow_na",
        "why", "fix", "fix_within_days", "last_reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(ADM|PHY|TEC|ORG|POL|DOC|INV)-[0-9]{3}$",
          "description": "Permanent ID. Never reuse or renumber."
        },
        "text": { "type": "string", "minLength": 10, "maxLength": 240 },
        "help": {
          "type": "string",
          "minLength": 10,
          "description": "Plain-language explanation shown under the question."
        },
        "citation": {
          "type": "string",
          "pattern": "^(45 CFR 16[0-4]\\.[0-9]+|NIST |HHS )",
          "description": "Regulation or official guidance this question derives from."
        },
        "implementation": {
          "enum": ["required", "addressable", "standard", "guidance"],
          "description": "How the CURRENT in-force rule treats this. 'standard' = a standard with no separate implementation specification; 'guidance' = best practice from HHS/NIST, not a rule text requirement."
        },
        "proposed_rule_2025": {
          "type": "object",
          "additionalProperties": false,
          "required": ["affected", "note"],
          "properties": {
            "affected": { "type": "boolean" },
            "note": { "type": "string" }
          },
          "description": "How the January 2025 NPRM (90 FR 898) would change this. The NPRM is NOT final law."
        },
        "likelihood": {
          "type": "integer", "minimum": 1, "maximum": 3,
          "description": "Likelihood a threat exploits this gap if the answer is No. 1=low, 3=high."
        },
        "impact": {
          "type": "integer", "minimum": 1, "maximum": 3,
          "description": "Impact on ePHI confidentiality/integrity/availability if exploited. 1=low, 3=high."
        },
        "critical": {
          "type": "boolean",
          "description": "A 'No' forces the overall rating to at least High."
        },
        "allow_na": { "type": "boolean" },
        "why": { "type": "string", "minLength": 10 },
        "fix": { "type": "string", "minLength": 10 },
        "fix_within_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "last_reviewed": { "type": "string", "format": "date" },
        "retired": { "type": "boolean" }
      }
    }
  }
}
